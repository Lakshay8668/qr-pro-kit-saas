# ==============================================================================
# QR PRO KIT — ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE (VITE) — Embedded into browser bundle during build
# ------------------------------------------------------------------------------
# Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef

# Cloud Storage flag: leave false or omitted for Firebase Starter tier (logos work client-side)
# VITE_FIREBASE_STORAGE_ENABLED=false

# Optional: Custom base URL for dynamic QR links (defaults to current site host)
# VITE_PUBLIC_BASE_URL=https://qr.yourbrand.com

# Optional: API base URL if frontend is deployed separately from the backend (e.g., GitHub Pages)
# On Railway (full-stack server), leave empty to use relative /api paths
# VITE_API_BASE_URL=https://your-railway-app.up.railway.app

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE ONLY (Railway / Node.js Production Server)
# NEVER prefix these with VITE_ to prevent leaking secrets to browser bundles.
# ------------------------------------------------------------------------------
# Server port (Railway injects PORT automatically, defaults to 3000 locally)
PORT=3000

# Canonical public app URL used for checkout redirect callbacks (e.g. Railway public domain)
APP_URL=https://your-railway-app.up.railway.app

# Firebase Admin Service Account JSON (raw JSON string or base64 encoded)
# Generate from: Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

# Optional secret for signing scan session cookies (defaults to a hash of the service account key)
COOKIE_SECRET=replace_with_a_secure_random_string_32_chars

# Comma-separated Firebase Auth UIDs of administrative users granted access to /admin
ADMIN_UIDS=your_firebase_auth_uid_here

# ------------------------------------------------------------------------------
# 3. RAZORPAY SUBSCRIPTIONS (India — UPI, Cards, Netbanking)
# ------------------------------------------------------------------------------
# Get Key ID & Secret from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...

# Webhook secret configured when creating the webhook in Razorpay Dashboard
# Webhook URL: https://YOUR-RAILWAY-DOMAIN/api/webhooks/razorpay
# Required Events:
#   subscription.activated, subscription.charged, subscription.pending,
#   subscription.halted, subscription.cancelled, subscription.completed, subscription.updated
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Razorpay Subscription Plan IDs (create in Razorpay Dashboard -> Subscriptions -> Plans)
# Pro: ₹299/month, ₹2,990/year
RAZORPAY_PLAN_PRO_MONTHLY=plan_...
RAZORPAY_PLAN_PRO_YEARLY=plan_...

# Business: ₹999/month, ₹9,990/year
RAZORPAY_PLAN_BUSINESS_MONTHLY=plan_...
RAZORPAY_PLAN_BUSINESS_YEARLY=plan_...

# ------------------------------------------------------------------------------
# 4. STRIPE SUBSCRIPTIONS (Optional: International Cards)
# ------------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_YEARLY=price_...
# STRIPE_PRICE_BUSINESS_MONTHLY=price_...
# STRIPE_PRICE_BUSINESS_YEARLY=price_...
